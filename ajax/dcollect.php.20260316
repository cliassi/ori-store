                    $con .= "<th>1</th><th colspan='4'><a class='customer-link' href='customer/details/$customer->id'>$customer->company ($customer->city) - <strong style='font-size:large'>$customer->code</strong></a></th>";
                }
                $con .= "</tr>
                </thead>
                <tbody>";
                    
                    $cat = "";
